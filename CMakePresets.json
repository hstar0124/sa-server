{
  "version": 8,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    { "name": "dev", "inherits": "base", "displayName": "Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "inherits": "base", "displayName": "Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" } },
    { "name": "asan", "inherits": "base", "displayName": "Debug + ASan/UBSan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SA_SANITIZER": "address" } },
    { "name": "tsan", "inherits": "base", "displayName": "Debug + TSan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SA_SANITIZER": "thread" } },
    { "name": "tidy", "inherits": "dev", "displayName": "Debug + clang-tidy",
      "cacheVariables": { "SA_ENABLE_CLANG_TIDY": "ON" } }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "tidy", "configurePreset": "tidy" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } }
  ]
}
