# Google base with the few deviations this repo standardises on.
BasedOnStyle: Google
Standard: c++20
ColumnLimit: 100
IndentWidth: 4
AccessModifierOffset: -4
DerivePointerAlignment: false
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"sa/'          # this repo's own headers
    Priority: 1
  - Regex: '^<(asio|grpc|google|spdlog|toml\+\+|gtest)'
    Priority: 3
  - Regex: '^<.*\.h>'
    Priority: 4
  - Regex: '^<.*>'          # C++ standard library
    Priority: 5
  - Regex: '.*'
    Priority: 2
